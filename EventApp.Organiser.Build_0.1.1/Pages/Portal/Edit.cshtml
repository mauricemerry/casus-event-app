@page "{id:int}"
@model EventApp.OrganiserPortal.Pages.Portal.EditModel

@{
    ViewData["Title"] = "Evenement bewerken";
    string[] access =
    [
        "Rolstoeltoegankelijk",
        "Lift aanwezig",
        "Toegankelijk toilet",
        "Gebarentolk",
        "Rustruimte",
        "Slechthorenden",
        "Slechtzienden",
        "Geleidehond toegestaan"
    ];
}
@section Head {
    <link rel="stylesheet" href="~/css/pages/create.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/map.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/image-upload.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
}

<div class="portal-shell">
    <div class="portal-form-card">
        <header class="wizard-heading">
            <h1>Evenement bewerken</h1>
            <div class="edit-header-actions">
                <button type="submit" form="cancel-event-form" class="portal-remove-ticket-btn">Evenement annuleren</button>            
                <a href="/Portal/Dashboard" class="remove-period-btn">Annuleren</a>
                <button type="submit" id="edit-save-event-header" form="edit-wizard-form" class="auth-submit-btn">Opslaan</button>   
            </div>
        </header>

        <nav class="event-steps" aria-label="Stappen">
            <button type="button" data-edit-step-button="1" class="active" aria-current="step">1 Basis</button>
            <button type="button" data-edit-step-button="2">2 Extra info</button>
            <button type="button" data-edit-step-button="3">3 Kaart</button>
            <button type="button" data-edit-step-button="4">4 Datum &amp; tijd</button>
            <button type="button" data-edit-step-button="5">5 Tickets</button>
            <button type="button" data-edit-step-button="6">6 Overzicht</button>
        </nav>

        <form method="post" id="edit-wizard-form" enctype="multipart/form-data" novalidate>
            <div asp-validation-summary="All" class="portal-validation-summary"></div>
            <div id="edit-wizard-summary" class="portal-validation-summary" hidden role="alert"></div>

            <section data-edit-step="1" class="wizard-step">
                <h2>Basis</h2>
                <p>Pas de basisgegevens van je evenement aan.</p>

                <div class="event-panel event-grid">
                    <div class="portal-form-group event-name-field">
                        <label asp-for="Input.EventName">Naam van het evenement</label>
                        <input asp-for="Input.EventName" maxlength="255" />
                        <span asp-validation-for="Input.EventName"></span>
                    </div>

                    <div class="portal-form-group">
                        <label asp-for="Input.EventType">Evenementtype</label>
                        <select asp-for="Input.EventType">
                            <option value="">Kies type...</option>
                            <option>Concert</option>
                            <option>Festival</option>
                            <option>Workshop</option>
                            <option>Theater</option>
                            <option>Sport</option>
                            <option>Overig</option>
                        </select>
                    </div>

                    <div class="event-panel">
                        <h3>Omgeving</h3>
                        <p>Meerdere opties mogelijk</p>
                        <div class="choice-grid">
                            <label class="choice"><input asp-for="Input.IsIndoor" type="checkbox" /> Binnen</label>
                            <label class="choice"><input asp-for="Input.IsOutdoor" type="checkbox" /> Buiten</label>
                            <label class="choice"><input asp-for="Input.IsOnline" type="checkbox" /> Online</label>
                        </div>
                    </div>
                </div>

                <div class="details-grid">
                    <div class="details-left">
                        <div class="event-panel portal-form-group">
                            <label asp-for="Input.Description">Omschrijving</label>
                            <textarea asp-for="Input.Description" rows="12" placeholder="Beschrijf het evenement..."></textarea>
                            <span asp-validation-for="Input.Description"></span>
                        </div>
                    </div>
                    <div class="details-right">
                        <div class="event-panel portal-form-group photo-panel">
                            <label asp-for="Input.Images" for="images-input">Foto's</label>
                            <input asp-for="Input.Images" id="images-input" type="file" accept=".jpg,.jpeg,.png,.webp" multiple hidden />

                            <div class="portal-image-strip-shell">
                                <div id="image-strip" class="portal-image-strip">
                                    @foreach (string imageUrl in Model.Input.ExistingImageUrls)
                                    {
                                        <div class="portal-image-slot existing-image-slot" data-image-url="@imageUrl">
                                            <img class="portal-image-thumb" src="@imageUrl" alt="Bestaande evenementfoto" />
                                            <input type="hidden" name="Input.KeptImageUrls" value="@imageUrl" />
                                            <button type="button" class="portal-image-remove-btn existing-image-remove-btn" aria-label="Bestaande afbeelding verwijderen">×</button>
                                        </div>
                                    }
                                </div>
                            </div>

                            <div id="image-meta-inputs"></div>
                            <small class="portal-image-help">Maximaal 10 foto's, 5 MB per foto.</small>
                        </div>
                    </div>
                </div>
            </section>

            <section data-edit-step="2" class="wizard-step" hidden>
                <h2>Extra info</h2>
                <div class="event-panel">
                    <h3>Toegankelijkheid</h3>
                    <div class="access-grid">
                        @foreach (var option in access)
                        {
                            <label class="choice">
                                <input type="checkbox" name="Input.AccessibilityOptionDescriptions" value="@option" checked="@(Model.Input.AccessibilityOptionDescriptions.Contains(option))" />
                                @option
                            </label>
                        }
                    </div>

                    <label class="choice full-choice">
                        <input asp-for="Input.HasCustomAccessibilityOptions" type="checkbox" id="edit-other-access" />
                        Overige
                    </label>
                    <div id="edit-other-access-wrap" class="portal-form-group" hidden="@(Model.Input.HasCustomAccessibilityOptions ? null : "hidden")">
                        <label asp-for="Input.CustomAccessibilityOptionDescriptions">Toelichting overige toegankelijkheid</label>
                        <textarea asp-for="Input.CustomAccessibilityOptionDescriptions" rows="2" maxlength="240"></textarea>
                    </div>
                </div>

                <div class="event-panel portal-form-group">
                    <label asp-for="Input.Notes">Notities</label>
                    <textarea asp-for="Input.Notes" rows="4"></textarea>
                </div>

                <div class="event-panel portal-form-group">
                    <label asp-for="Input.CategoryName">Categorie</label>
                    <select asp-for="Input.CategoryName">
                        <option value="">Kies categorie</option>
                        <option>Muziek</option>
                        <option>Festival</option>
                        <option>Theater</option>
                        <option>Sport</option>
                        <option>Workshop</option>
                        <option>Overig</option>
                    </select>
                </div>

                <div class="event-panel portal-form-group">
                    <label for="edit-tags">Tags</label>
                    <div id="edit-tags-list" class="tags-list">
                        @for (int i = 0; i < Model.Input.Tags.Count; i++)
                        {
                            <span class="tag-pill">
                                @Model.Input.Tags[i]
                                <button type="button" class="tag-remove" aria-label="Tag verwijderen">×</button>
                                <input type="hidden" name="Input.Tags[@i]" value="@Model.Input.Tags[i]" />
                            </span>
                        }
                    </div>
                    <input id="edit-tag-text" placeholder="Typ een tag en druk op Enter" maxlength="100" />
                </div>

            </section>

            <section data-edit-step="3" class="wizard-step" hidden>
                <h2>Locatie</h2>
                <p>Kies de locatie van het evenement.</p>
                <div class="location-layout">
                    <div id="location-list">
                        <div id="location-tabs" class="location-tabs" role="tablist" aria-label="Locaties">
                            @for (int i = 0; i < Model.Input.Locations.Count; i++)
                            {
                                <button type="button" role="tab" data-location-tab="@i" class="@(i == 0 ? "active" : string.Empty)" aria-selected="@(i == 0 ? "true" : "false")">Locatie @(i + 1)</button>
                            }
                            <button type="button" id="edit-add-location" class="location-add-button" title="Locatie toevoegen" aria-label="Locatie toevoegen">+</button>
                        </div>
                        @for (int i = 0; i < Model.Input.Locations.Count; i++)
                        {
                        <div class="event-panel location-row" data-location-panel="@i" role="tabpanel" @(i == 0 ? string.Empty : "hidden")>
                            <div class="portal-form-group">
                                <label asp-for="Input.Locations[i].Name">Locatienaam</label>
                                <input asp-for="Input.Locations[i].Name" placeholder="Hoofdingang" />
                            </div>

                            <div class="portal-form-group">
                                <label asp-for="Input.Locations[i].City">Plaats</label>
                                <input asp-for="Input.Locations[i].City" placeholder="Plaats" />
                            </div>

                            <div class="portal-form-group">
                                <label asp-for="Input.Locations[i].Street">Straat</label>
                                <input asp-for="Input.Locations[i].Street" placeholder="Straat" />
                            </div>

                            <div class="event-grid">
                                <div class="portal-form-group">
                                    <label asp-for="Input.Locations[i].Number">Nummer</label>
                                    <input asp-for="Input.Locations[i].Number" placeholder="Huisnummer" />
                                </div>
                                <div class="portal-form-group">
                                    <label asp-for="Input.Locations[i].Addition">Toevoeging</label>
                                    <input asp-for="Input.Locations[i].Addition" placeholder="Optioneel" />
                                </div>
                            </div>

                            <div class="portal-form-group">
                                <label asp-for="Input.Locations[i].PostalCode">Postcode</label>
                                <input asp-for="Input.Locations[i].PostalCode" placeholder="Postcode" />
                            </div>

                            <input asp-for="Input.Locations[i].Latitude" type="hidden" class="location-lat" />
                            <input asp-for="Input.Locations[i].Longitude" type="hidden" class="location-lng" />

                            @if (i == 0)
                            {
                                <input asp-for="Input.Latitude" type="hidden" id="latitude-input" />
                                <input asp-for="Input.Longitude" type="hidden" id="longitude-input" />
                            }

                        </div>
                        }
                    </div>
                    <div class="event-panel location-map-panel">
                        <div id="event-location-map" class="portal-map-canvas"></div>
                        <p id="map-status" aria-live="polite">Klik op de kaart om een pin te plaatsen.</p>
                    </div>
                </div>
            </section>

            <section data-edit-step="4" class="wizard-step" hidden>
                <h2>Datum &amp; tijd</h2>
                <p>Pas de periode van het evenement aan.</p>
                <input asp-for="Input.StartDateTime" type="hidden" id="edit-start-datetime" />
                <input asp-for="Input.EndDateTime" type="hidden" id="edit-end-datetime" />

                <div class="table-scroll">
                    <div class="period-table">
                        <div class="period-head">
                            <b>Naam / periode</b>
                            <b>Startdatum</b>
                            <b>Starttijd</b>
                            <b>Einddatum</b>
                            <b>Eindtijd</b>
                            <b>Acties</b>
                        </div>
                        <div id="period-list">
                            @for (int i = 0; i < Model.Input.Periods.Count; i++)
                            {
                                <div class="period-row" data-period-row>
                                    <label for="edit-period-name-@i">Openingsdag</label>
                                    <input id="edit-period-name-@i" name="Input.Periods[@i].Name" value="@Model.Input.Periods[i].Name" data-period-field="Name" maxlength="100" />
                                    <label for="edit-period-start-date-@i">Startdatum</label>
                                    <input id="edit-period-start-date-@i" name="Input.Periods[@i].StartDate" value="@(Model.Input.Periods[i].StartDate?.ToString("yyyy-MM-dd"))" data-period-field="StartDate" type="date" />
                                    <label for="edit-period-start-time-@i">Starttijd</label>
                                    <input id="edit-period-start-time-@i" name="Input.Periods[@i].StartTime" value="@(Model.Input.Periods[i].StartTime?.ToString(@"hh\:mm"))" data-period-field="StartTime" type="time" />
                                    <label for="edit-period-end-date-@i">Einddatum</label>
                                    <input id="edit-period-end-date-@i" name="Input.Periods[@i].EndDate" value="@(Model.Input.Periods[i].EndDate?.ToString("yyyy-MM-dd"))" data-period-field="EndDate" type="date" />
                                    <label for="edit-period-end-time-@i">Eindtijd</label>
                                    <input id="edit-period-end-time-@i" name="Input.Periods[@i].EndTime" value="@(Model.Input.Periods[i].EndTime?.ToString(@"hh\:mm"))" data-period-field="EndTime" type="time" />
                                    <button type="button" class="remove-period-btn">Verwijderen</button>
                                </div>
                            }
                        </div>
                        <button type="button" id="edit-add-period" class="portal-secondary-link">+ Periode toevoegen</button>
                    </div>
                </div>
            </section>

            <section data-edit-step="5" class="wizard-step" hidden>
                <h2>Tickets</h2>
                <p>Alle velden zijn aanpasbaar per ticket.</p>
                <div id="ticket-list">
                    @for (int i = 0; i < Model.Input.Tickets.Count; i++)
                    {
                        <div class="ticket-row">
                            <input name="Input.Tickets[@i].Name" value="@Model.Input.Tickets[i].Name" class="ticket-name" placeholder="Naam" aria-label="Ticketnaam" />
                            <div class="ticket-price-wrap"><input name="Input.Tickets[@i].Price" value="@Model.Input.Tickets[i].Price" class="ticket-price" type="number" step="0.01" min="0" placeholder="Prijs (€)" aria-label="Ticketprijs" /></div>
                            <select name="Input.Tickets[@i].TypeName" class="ticket-kind" aria-label="Tickettype">
                                @foreach (string type in new[] { "Gratis", "Dagticket", "Periode", "Tijdslot" })
                                {
                                    <option selected="@(Model.Input.Tickets[i].TypeName == type)">@type</option>
                                }
                            </select>
                            <button type="button" class="remove-ticket remove-row" aria-label="Ticket verwijderen">✕</button>
                        </div>
                    }
                </div>
                <button type="button" id="add-ticket" class="portal-secondary-link">+ Ticket toevoegen</button>
            </section>

            <section data-edit-step="6" class="wizard-step" hidden>
                <h2>Alle info</h2>
                <p>Controleer alle ingevulde gegevens.</p>
                <div id="edit-summary-content" class="summary-grid"></div>
            </section>

            <div class="event-navigation edit-event-navigation">
                <div class="event-navigation-start">
                    <button type="button" id="edit-previous-step" class="portal-secondary-link" hidden>← Vorige</button>
                </div>
                <span id="edit-step-counter" aria-live="polite">Stap 1 van 6</span>
                <div class="event-navigation-end">
                    <button type="button" id="edit-next-step" class="auth-submit-btn">Volgende →</button>
                    <button type="submit" id="edit-save-event" class="auth-submit-btn" hidden>Evenement opslaan</button>
                </div>
            </div>

            <div id="image-position-modal" class="portal-image-modal" hidden>
                <div class="portal-image-modal-card">
                    <div class="portal-image-modal-header">
                        <h3>Afbeelding aanpassen</h3>
                        <button type="button" id="close-image-modal" class="portal-image-modal-close" aria-label="Venster sluiten">×</button>
                    </div>
                    <div class="portal-image-modal-preview-wrap">
                        <div class="portal-image-modal-preview">
                            <img id="position-preview-image" alt="Foto aanpassen" />
                        </div>
                    </div>
                    <div class="portal-image-modal-controls">
                        <label for="position-x-range">Horizontaal</label>
                        <input id="position-x-range" type="range" min="0" max="100" value="50" />
                        <label for="position-y-range">Verticaal</label>
                        <input id="position-y-range" type="range" min="0" max="100" value="50" />
                    </div>
                    <div class="portal-image-modal-actions">
                        <button type="button" id="save-image-position" class="auth-submit-btn">Aanpassing opslaan</button>
                    </div>
                </div>
            </div>
        </form>

        <form method="post" asp-page-handler="Cancel" id="cancel-event-form">
            <input type="hidden" asp-for="Id" />
        </form>

        <div id="cancel-confirm-modal" class="edit-confirm-modal" hidden role="dialog" aria-modal="true" aria-labelledby="cancel-confirm-title">
            <div class="edit-confirm-card">
                <h2 id="cancel-confirm-title">Evenement annuleren?</h2>
                <p>Weet je zeker dat je dit evenement wilt annuleren? Deze actie kan niet eenvoudig worden teruggedraaid.</p>
                <div class="edit-confirm-actions">
                    <button type="button" id="cancel-confirm-no" class="edit-confirm-secondary">Niet annuleren</button>
                    <button type="button" id="cancel-confirm-yes" class="edit-confirm-danger">Annuleren</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="~/js/create-event-map.js" asp-append-version="true"></script>
    <script src="~/js/image-upload-strip.js" asp-append-version="true"></script>
    <script src="~/js/edit-event-wizard.js" asp-append-version="true"></script>
}