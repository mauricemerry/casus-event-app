@page
@model EventApp.OrganiserPortal.Pages.Portal.CreateModel

@{
    ViewData["Title"] = "Evenement aanmaken";

    string[] access =
    [
        "Rolstoeltoegankelijk",
        "Lift aanwezig",
        "Toegankelijk toilet",
        "Gebarentolk",
        "Rustruimte",
        "Slechthorenden",
        "Slechtzienden",
        "Geleidehond toegestaan"
    ];
}

@section Head {
    <link rel="stylesheet"
          href="~/css/pages/create.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/css/components/map.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/css/components/image-upload.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
}

<div class="portal-shell">
    <div class="portal-form-card">
        <header class="wizard-heading">
            <h1>Evenement aanmaken</h1>
            <a href="/Portal/Dashboard" class="remove-period-btn">
                Annuleren
            </a>
        </header>

        <nav class="event-steps" aria-label="Stappen">
            <button type="button" data-step="1" class="active" aria-current="step">
                1 Basis
            </button>
            <button type="button" data-step="2">
                2 Extra info
            </button>
            <button type="button" data-step="3">
                3 Kaart
            </button>
            <button type="button" data-step="4">
                4 Datum &amp; tijd
            </button>
            <button type="button" data-step="5">
                5 Tickets
            </button>
            <button type="button" data-step="6">
                6 Overzicht
            </button>
        </nav>

        <form method="post"
              enctype="multipart/form-data"
              id="wizard-form"
              novalidate
              data-initial-step="@Model.CurrentStep">

            <div asp-validation-summary="All"
                 class="portal-validation-summary"></div>
            <div id="wizard-client-errors"
                 class="portal-validation-summary"
                 hidden
                 role="alert"></div>

            <!-- STAP 1: BASIS -->
            <section data-content-step="1" class="wizard-step">
                <h2>Basis</h2>
                <p>Vertel ons wat voor evenement je organiseert.</p>

                <div class="event-panel event-grid">
                    <div class="portal-form-group event-name-field">
                        <label asp-for="Input.EventName">
                            Naam van het evenement
                        </label>
                        <input asp-for="Input.EventName"
                               placeholder="Bijvoorbeeld: Summer Festival"
                               maxlength="255" />
                        <span asp-validation-for="Input.EventName"></span>
                    </div>

                    <div class="portal-form-group">
                        <label asp-for="Input.EventType">
                            Evenementtype
                        </label>
                        <select asp-for="Input.EventType">
                            <option value="">Kies type...</option>
                            <option>Concert</option>
                            <option>Festival</option>
                            <option>Workshop</option>
                            <option>Theater</option>
                            <option>Sport</option>
                            <option>Overig</option>
                        </select>
                        <span asp-validation-for="Input.EventType"></span>
                    </div>

                     <div class="event-panel">
                            <h3>Omgeving</h3>
                            <p>Meerdere opties mogelijk</p>

                            <div class="choice-grid">
                                <label class="choice">
                                    <input asp-for="Input.IsIndoor"
                                           type="checkbox" />
                                    Binnen
                                </label>
                                <label class="choice">
                                    <input asp-for="Input.IsOutdoor"
                                           type="checkbox" />
                                    Buiten
                                </label>
                                <label class="choice">
                                    <input asp-for="Input.IsOnline"
                                           type="checkbox" />
                                    Online
                                </label>
                            </div>
                        </div>
                    
                </div>

                <div class="details-grid">
                    <div class="details-left">
                        <div class="event-panel portal-form-group">
                            <label asp-for="Input.Description">
                                Omschrijving
                            </label>
                            <textarea asp-for="Input.Description"
                                      rows="12"
                                      placeholder="Beschrijf het evenement..."></textarea>
                            <span asp-validation-for="Input.Description"></span>
                        </div>
                    </div>

                    <div class="details-right">
                        <div class="event-panel portal-form-group photo-panel">
                            <label asp-for="Input.Images" for="images-input">Foto's</label>

                            <input asp-for="Input.Images" id="images-input"
                                   type="file"
                                   accept=".jpg,.jpeg,.png,.webp"
                                   multiple
                                   hidden />

                            <div class="portal-image-strip-shell">
                                <div id="image-strip"
                                     class="portal-image-strip"></div>
                            </div>

                            <div id="image-meta-inputs"></div>

                            <small>Maximaal 10 foto's, 5 MB per foto.</small>
                        </div>

                       
                    </div>
                </div>
            </section>

            <!-- STAP 2: EXTRA INFO -->
            <section data-content-step="2"
                     class="wizard-step"
                     hidden>
                <h2>Extra info</h2>

                <div data-extra-content="access"
                     class="extra-content">
                    <div class="event-panel">
                        <h3>Toegankelijkheid</h3>

                        <div class="access-grid">
                            @foreach (var option in access)
                            {
                                <label class="choice">
                                    <input type="checkbox"
                                            name="Input.AccessibilityOptionDescriptions"
                                           value="@option"
                                           checked="@(Model.Input.AccessibilityOptionDescriptions.Contains(option))" />
                                    @option
                                </label>
                            }
                        </div>

                        <label class="choice full-choice">
                            <input asp-for="Input.HasCustomAccessibilityOptions"
                                   type="checkbox"
                                   id="other-access" />
                            Overige
                        </label>

                        <div id="other-access-wrap"
                             class="portal-form-group"
                             hidden>
                            <label asp-for="Input.CustomAccessibilityOptionDescriptions">
                                Toelichting overige toegankelijkheid
                            </label>
                            <textarea asp-for="Input.CustomAccessibilityOptionDescriptions"
                                      rows="2"
                                      maxlength="240"
                                      placeholder="Beschrijf overige voorzieningen..."></textarea>
                        </div>
                    </div>

                    <div class="event-panel portal-form-group">
                        <label asp-for="Input.Notes">Notities</label>
                        <textarea asp-for="Input.Notes"
                                  rows="4"
                                  placeholder="Extra toegankelijkheids informatie voor bezoekers..."></textarea>
                    </div>

                    <div class="event-panel portal-form-group">
                        <label asp-for="Input.CategoryName">
                            Categorie
                        </label>
                        <select asp-for="Input.CategoryName">
                            <option value="">Kies categorie</option>
                            <option>Muziek</option>
                            <option>Festival</option>
                            <option>Theater</option>
                            <option>Sport</option>
                            <option>Workshop</option>
                            <option>Overig</option>
                        </select>
                    </div>

                    <div class="event-panel portal-form-group">
                        <label for="tag-text">Tags</label>

                        <div id="tags-list" class="tags-list">
                            @for (int i = 0; i < Model.Input.Tags.Count; i++)
                            {
                                <input type="hidden"
                                       name="Input.Tags[@i]"
                                       value="@Model.Input.Tags[i]" />
                            }
                        </div>

                        <input id="tag-text"
                               placeholder="Typ een tag en druk op Enter - een tag is iets waar je op kan zoeken om je evenement te vinden"
                               maxlength="100" />
                    </div>
                </div>
            </section>

            <!-- STAP 3: KAART / LOCATIES -->
            <section data-content-step="3"
         class="wizard-step"
         hidden>

    <h2>Locaties</h2>

    <div data-extra-content="locations"
         class="extra-content">

        <div class="location-tabs" id="location-tabs"></div>

        <div class="location-layout">

            <div id="location-list">
                @for (int i = 0; i < Model.Input.Locations.Count; i++)
                {
                    <div class="event-panel location-row"
                         data-location-row>

                        <div class="portal-form-group">
                            <label>Locatienaam</label>
                            <input asp-for="Input.Locations[i].Name"
                                   class="location-name"
                                   placeholder="Hoofdingang" />
                        </div>

                        <div class="portal-form-group">
                            <label>Plaats</label>
                            <input asp-for="Input.Locations[i].City"
                                   placeholder="Plaats" />
                        </div>

                        <div class="portal-form-group"> 
                            <label>Straat</label>
                            <input asp-for="Input.Locations[i].Street"
                                   placeholder="Straat" />
                        </div>

                        <div class="event-grid">
                            <div class="portal-form-group">
                                <label>Nummer</label>
                                <input asp-for="Input.Locations[i].Number"
                                       placeholder="Huisnummer" />
                            </div>

                            <div class="portal-form-group">
                                <label>Toevoeging</label>
                                <input asp-for="Input.Locations[i].Addition"
                                       placeholder="Optioneel" />
                            </div>
                        </div>

                        <div class="portal-form-group">
                            <label>Postcode</label>
                            <input asp-for="Input.Locations[i].PostalCode"
                                   placeholder="Postcode" />
                        </div>

                        <input asp-for="Input.Locations[i].Latitude"
                               type="hidden"
                               class="location-lat" />

                        <input asp-for="Input.Locations[i].Longitude"
                               type="hidden"
                               class="location-lng" />

                        <button type="button"
                                class="remove-location portal-secondary-link">
                            Locatie verwijderen
                        </button>
                    </div>
                }
            </div>

            <div class="event-panel location-map-panel">
                <div id="event-location-map"
                     class="portal-map-canvas"></div>

                <button type="button"
                        id="find-location"
                        class="portal-secondary-link">
                    Zoek adres / kies locatie
                </button>

                <p id="map-status" aria-live="polite">
                    Klik op de kaart om een pin te plaatsen.
                </p>
            </div>

        </div>
    </div>
</section>

            <!-- STAP 4: DATUM EN TIJD -->
            <section data-content-step="4"
                     class="wizard-step"
                     hidden>
                <h2>Datum &amp; tijd</h2>
                <p>
                    Voeg één of meer periodes toe.
                    Elke periode heeft een naam, een begindatum
                    en een einddatum met tijden.
                </p>

                <div class="table-scroll">
                    <div class="period-table">
                        <div class="period-head">
                            <b>Naam / periode</b>
                            <b>Startdatum</b>
                            <b>Starttijd</b>
                            <b>Einddatum</b>
                            <b>Eindtijd</b>
                            <b>Acties</b>
                        </div>

                        <div id="period-list">
                            @for (int i = 0; i < Model.Input.Periods.Count; i++)
                            {
                                <div class="period-row">
                                    <label asp-for="Input.Periods[i].Name">
                                        Openingsdag
                                    </label>
                                    <input asp-for="Input.Periods[i].Name"
                                           data-period-field="Name"
                                           maxlength="100"
 />

                                    <label asp-for="Input.Periods[i].StartDate">
                                        Startdatum
                                    </label>
                                    <input asp-for="Input.Periods[i].StartDate"
                                           data-period-field="StartDate"
                                           type="date" />

                                    <label asp-for="Input.Periods[i].StartTime">
                                        Starttijd
                                    </label>
                                    <input asp-for="Input.Periods[i].StartTime"
                                           data-period-field="StartTime"
                                           type="time" />

                                    <label asp-for="Input.Periods[i].EndDate">
                                        Einddatum
                                    </label>
                                    <input asp-for="Input.Periods[i].EndDate"
                                           data-period-field="EndDate"
                                           type="date" />

                                    <label asp-for="Input.Periods[i].EndTime">
                                        Eindtijd
                                    </label>
                                    <input asp-for="Input.Periods[i].EndTime"
                                           data-period-field="EndTime"
                                           type="time" />

                                    <button type="button"
                                            class="remove-period-btn">
                                        Verwijderen
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <button type="button"
                        id="add-period"
                        class="portal-secondary-link">
                    + Periode toevoegen
                </button>
            </section>

            <!-- STAP 5: TICKETS -->
            <section data-content-step="5"
                     class="wizard-step"
                     hidden>
                <h2>Tickets</h2>
                <p>Alle velden zijn aanpasbaar per ticket.</p>

                <div id="ticket-list">
                    @for (int i = 0; i < Model.Input.Tickets.Count; i++)
                    {
                        var ticket = Model.Input.Tickets[i];

                        <div class="ticket-row">
                            <input asp-for="Input.Tickets[i].Name"
                                   class="ticket-name"
                                   placeholder="Naam"
                                   aria-label="Ticketnaam" />

                            <div class="ticket-price-wrap">
                                <input asp-for="Input.Tickets[i].Price"
                                       class="ticket-price"
                                       type="number"
                                       step="0.01"
                                       min="0"
                                       placeholder="Prijs (€)"
                                       aria-label="Ticketprijs" />
                            </div>

                            <select asp-for="Input.Tickets[i].TypeName"
                                    class="ticket-kind"
                                    aria-label="Tickettype">
                                <option>Gratis</option>
                                <option>Dagticket</option>
                                <option>Periode</option>
                                <option>Tijdslot</option>
                            </select>

                            <div class="ticket-dates">
                                <div class="ticket-single">
                                    <input asp-for="Input.Tickets[i].Date"
                                           type="date"
                                           aria-label="Ticketdatum" />
                                </div>

                                <div class="ticket-slot">
                                    <input asp-for="Input.Tickets[i].SlotStart"
                                           type="time"
                                           aria-label="Begintijd tijdslot" />
                                    <input asp-for="Input.Tickets[i].SlotEnd"
                                           type="time"
                                           aria-label="Eindtijd tijdslot" />
                                </div>

                                <div class="ticket-period">
                                    <div class="period-date-list">
                                        @for (int j = 0; j < ticket.PeriodDates.Count; j++)
                                        {
                                            <input type="date"
                                                   name="Input.Tickets[@i].PeriodDates[@j]"
                                                   value="@(ticket.PeriodDates[j]?.ToString("yyyy-MM-dd"))"
                                                   aria-label="Dag van periodeticket" />
                                        }
                                    </div>

                                    <button type="button"
                                            class="add-day portal-secondary-link">
                                        + dag toevoegen
                                    </button>
                                </div>
                            </div>

                            <button type="button"
                                    class="remove-ticket remove-row"
                                    aria-label="Ticket verwijderen">
                                ✕
                            </button>
                        </div>
                    }
                </div>

                <button type="button"
                        id="add-ticket"
                        class="portal-secondary-link">
                    + Ticket toevoegen
                </button>

                <p>
                    <small>
                        Bij type Gratis of ticketnaam Gratis
                        wordt de prijs automatisch €0.
                    </small>
                </p>
            </section>

            <!-- STAP 6: PUBLICEREN -->
            <section data-content-step="6"
                     class="wizard-step"
                     hidden>
                <h2>Publiceren</h2>
                <p>Controleer alle ingevulde gegevens.</p>
                <div id="summary-content"
                     class="summary-grid"></div>
            </section>

            <div class="event-navigation">
                <button type="button"
                        id="previous-step"
                        class="portal-secondary-link"
                        hidden>
                    ← Vorige
                </button>

                <span id="step-counter" aria-live="polite">
                    Stap 1 van 6
                </span>

                <button type="button"
                        id="next-step"
                        class="auth-submit-btn">
                    Volgende →
                </button>

                <button type="submit"
                        id="publish-event"
                        class="auth-submit-btn"
                        hidden>
                    Evenement opslaan
                </button>
            </div>

            <div id="image-position-modal"
                 class="portal-image-modal"
                 hidden>
                <div class="portal-image-modal-card">
                    <div class="portal-image-modal-header">
                        <h3>Afbeelding positioneren</h3>

                        <button type="button"
                                id="close-image-modal"
                                class="portal-image-modal-close"
                                aria-label="Venster sluiten">
                            ×
                        </button>
                    </div>

                    <div class="portal-image-modal-preview-wrap">
                        <div class="portal-image-modal-preview">
                            <img id="position-preview-image"
                                 alt="Foto bijsnijden" />
                        </div>
                    </div>

                    <div class="portal-image-modal-controls">
                        <label for="position-x-range">Horizontaal</label>
                        <input id="position-x-range"
                               type="range"
                               min="0"
                               max="100"
                               value="50" />

                        <label for="position-y-range">Verticaal</label>
                        <input id="position-y-range"
                               type="range"
                               min="0"
                               max="100"
                               value="50" />
                    </div>

                    <div class="portal-image-modal-actions">
                        <button type="button"
                                id="save-image-position"
                                class="auth-submit-btn">
                            Opslaan
                        </button>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <script src="~/js/create-event-map"
            asp-append-version="true"></script>

    <script src="~/js/image-upload-strip.js"
            asp-append-version="true"></script>

    <script src="~/js/create-event-wizard.js"
            asp-append-version="true"></script>
}