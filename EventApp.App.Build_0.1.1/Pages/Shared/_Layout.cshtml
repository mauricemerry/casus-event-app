<!DOCTYPE html>
<html lang="nl">
<head>
    
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EventApp</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/topbar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/sidebar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/forms.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/event-card.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/bookmarks.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/auth-modal.css" asp-append-version="true" />

    @RenderSection("Head", required: false)
</head>
<body>
    @RenderBody()

    <script src="~/js/pages/home.js" asp-append-version="true"></script>
    <script src="~/js/components/bookmarks.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>